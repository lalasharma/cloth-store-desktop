<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <appSettings>
    <add key="DatabaseServer" value="(LocalDB)\MSSQLLocalDB" />
    <add key="DatabaseName" value="ClothStoreDB" />
    <add key="EnableDatabaseAutoInit" value="true" />
  </appSettings>
  <connectionStrings>
    <add name="ClothStoreDB" connectionString="Server=(LocalDB)\MSSQLLocalDB;Database=ClothStoreDB;Integrated Security=true;Connection Timeout=30" providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
